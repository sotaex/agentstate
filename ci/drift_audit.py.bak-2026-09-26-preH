pol = json.load(open(os.path.join(proj, ".psl", "policy.json"), encoding="utf-8"))
pol["whitelist"]["commands"] = ["rm -rf /tmp/x"]
json.dump(pol, open(os.path.join(proj, ".psl", "policy.json"), "w", encoding="utf-8"))
