#!/bin/sh
# Antinel 统一交付闸门 —— 提交前自动运行（**快道**）
#
# ★ 为什么必须有这一半：
#   光有闸门文件 ≠ 闸门会被跑。**没人跑的检查项＝没检查项**
#   （MEMORY：「无检查项的禁令＝没禁令」的反面同样成立）。
#   这个钩子把「跑闸门」变成 git 提交的**前置条件**，不通过就提交不了。
#
# ★★ 2026-10-13 两处实测修正（都不是洁癖，都是真发生过的）：
#   ① **部署漂移**：本文件在仓内 `ci/git-hooks/pre-commit`，而 `.git/hooks/pre-commit`
#      是 09-28 拷的、**6 天没跟源** —— 那个"一处入口"的强制点实际是断的，
#      28 套快档判据在这 6 天里**一次都没在提交时跑过**。
#      ⇒ 现在由判据 D-33 正面守着「部署件必须与仓内源逐字一致」。
#   ② **快道**：原先跑 `--quick`（只秒级档），而主闸门实测 **68s**
#      ⇒ 钩子慢到会被 `--no-verify` 绕过，而**会被绕过的钩子等于没有钩子**。
#      ⇒ 现在跑 `--hook`：受影响套件（按历史耗时做预算，跳过什么**逐条列明**）
#        ＋ 主闸门（快档）。**快道不是全量凭证** ——
#        全量凭证只有 `python ci/delivery_gate.py`（打包前/CI 两个执行点）。
#
# 部署：本文件在仓内 ci/git-hooks/pre-commit，需复制到 .git/hooks/pre-commit
#       `cp ci/git-hooks/pre-commit .git/hooks/pre-commit`
#       （install 命令见 ci/README-gate.md；判据 D-33 会检查这两份是否一致）
#
# 绕过（仅在明确知情时）：git commit --no-verify
#   —— 但绕过会在审计链留痕（见下方 log），不是悄悄溜过去

PY="${ANTINEL_PY:-python}"
ROOT="$(git rev-parse --show-toplevel)"
GATE="$ROOT/ci/delivery_gate.py"

if [ ! -f "$GATE" ]; then
    echo "[gate] 找不到 $GATE —— 跳过（这不是通过，是缺失）" >&2
    exit 0
fi

# ── before 基线提醒（§6.1 / 遗留问题 C3）：**出声，但不拦截** ──────────────
#   §6.1 要求「**开工前**先打 tag `pre-<批次>-<日期>`」——没有 before 就没有
#   「提升」的证据（实测这一轮没打，before 只能靠旧 commit 的 worktree 补渲染，
#   等价但迟到）。这里在**最早能机械介入的时刻**（第一次产品提交）出声一次。
#   ★★ 永远不参与 rc（`|| true`）：`git tag` 不区分用途，机器**判不了**
#      「本批有没有自己的基线」⇒ 判违规会时红时绿（本仓铁律：时红时绿比恒红更坏）。
#      所以它只提醒；裁决权留给人与 §6.1 的截图清单。见 `ci/baseline_tag.py` 头。
if [ -f "$ROOT/ci/baseline_tag.py" ]; then
    "$PY" "$ROOT/ci/baseline_tag.py" --remind || true
fi

echo "[gate] 统一交付闸门 · 快道运行中（受影响套件 ＋ 主闸门，预算约 30 秒）……" >&2
"$PY" "$GATE" --hook
rc=$?

if [ "$rc" -ne 0 ]; then
    echo "" >&2
    echo "★★ 提交被拦：统一交付闸门未通过。" >&2
    echo "   三种可能，请**先分辨**再动手（它们修法完全不同）：" >&2
    echo "     ❌ 变红     ⇒ 有判据检出缺陷，或判据自身需更新" >&2
    echo "     💥 崩/缺失  ⇒ 判据没跑成 —— 这不是通过，是盲区" >&2
    echo "     ⚠️ 零输出   ⇒ 判据提前退出，退出码 0 也不许当通过" >&2
    echo "   修好后重跑：$PY ci/delivery_gate.py --hook" >&2
    echo "   确知无害要绕过：git commit --no-verify（会在审计链留痕）" >&2
    exit 1
fi

echo "[gate] 快道全绿，放行提交。" >&2
echo "[gate] 提醒：快道**不是全量凭证** —— 打包前请跑 $PY ci/delivery_gate.py（全量 30 套）" >&2
exit 0
