#!/bin/sh
# Antinel 统一交付闸门 —— 提交前自动运行
#
# ★ 为什么必须有这一半（0.36.5 补记，本轮最重要的一处结构性修复）：
#   光有闸门文件 ≠ 闸门会被跑。**没人跑的检查项＝没检查项**。
#
#   ★★ 0.36.5 实测：在此之前，本仓有 **113 条值守台判据 ＋ 7 条交付自检**
#     **一条都没有任何调用方** —— 0363 有一条红、0364 有一条红，
#     **已经红了一段时间却没人知道**，因为没人跑。
#     ⇒ 这就是本仓铁律「无检查项的禁令＝没禁令」的**镜像**：
#       **有检查项但没人跑 ＝ 同样等于没有。**
#       两个方向都是"看起来有防护，实际没有"。
#
#   修法（与本仓既有做法一致，纪律早就有，只是没落实到执行点）：
#     一处入口 `ci/delivery_gate.py` ＋ 三个强制点（本钩子 / 打包前 / CI）。
#     入口只负责调起与汇总，**不二次实现任何判据**。
#
# 部署：本文件在仓内 ci/git-hooks/pre-commit，需复制/链接到 .git/hooks/pre-commit
#       （install 命令见 ci/README-gate.md）
#
# 绕过（仅在明确知情时）：git commit --no-verify
#   —— 但绕过会在审计链留痕（见下方 log），不是悄悄溜过去

PY="${ANTINEL_PY:-python}"
ROOT="$(git rev-parse --show-toplevel)"
GATE="$ROOT/ci/delivery_gate.py"

if [ ! -f "$GATE" ]; then
    echo "[gate] 找不到 $GATE —— 跳过（这不是通过，是缺失）" >&2
    exit 0
fi

# ★ 提交前用 --quick（秒级档）：值守台判据 ＋ 自检 ＋ 版本一致性。
#   slow 档（回归闸门 / 0353）由「打包前」与「CI」两个执行点覆盖 ——
#   提交钩子里跑全量会把提交体验拖到不可用，而不可用的钩子会被 --no-verify 绕过，
#   那就等于没有钩子。⇒ 分档是**为了让强制点真的会被用**，不是偷懒。
echo "[gate] 统一交付闸门运行中（秒级档，约 15 秒）……" >&2
"$PY" "$GATE" --quick
rc=$?

if [ "$rc" -ne 0 ]; then
    echo "" >&2
    echo "★★ 提交被拦：统一交付闸门未通过。" >&2
    echo "   三种可能，请**先分辨**再动手（它们修法完全不同）：" >&2
    echo "     ❌ 变红     ⇒ 有判据检出缺陷，或判据自身需更新" >&2
    echo "     💥 崩/缺失  ⇒ 判据没跑成 —— 这不是通过，是盲区" >&2
    echo "     ⚠️ 零输出   ⇒ 判据提前退出，退出码 0 也不许当通过" >&2
    echo "   修好后重跑：$PY ci/delivery_gate.py --quick" >&2
    echo "   确知无害要绕过：git commit --no-verify（会在审计链留痕）" >&2
    exit 1
fi

echo "[gate] 全绿，放行提交。" >&2
exit 0
